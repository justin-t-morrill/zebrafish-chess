@@ -32,6 +32,36 @@ logger = logging.getLogger(__name__)
 out_of_online_opening_book_moves: Counter[str] = Counter()
 
 
+def load_opening_names() -> dict[str, str]:
+    """Load the engine's ECO names, keyed without move counters.
+
+    The C engine identifies positions by Zobrist hash, which likewise ignores
+    the halfmove and fullmove counters.  Using the first four FEN fields keeps
+    the bridge's lookup equivalent while avoiding a second chess dependency.
+    """
+    names: dict[str, str] = {}
+    # The shared opening data lives at the project root after the workspace
+    # migration: integrations/lichess-bot/lib -> openings/book.
+    path = os.path.abspath(os.path.join(
+        os.path.dirname(__file__), "..", "..", "..",
+        "openings", "book", "OpeningNames.tsv"))
+    try:
+        with open(path, encoding="utf-8") as opening_file:
+            next(opening_file, None)  # fen\teco\tname header
+            for line in opening_file:
+                fields = line.rstrip("\r\n").split("\t", 2)
+                if len(fields) != 3:
+                    continue
+                fen, eco, name = fields
+                names[" ".join(fen.split()[:4])] = f"{eco} {name}"
+    except OSError as error:
+        logger.warning(f"Could not load opening names from {path}: {error}")
+    return names
+
+
+opening_names = load_opening_names()
+
+
