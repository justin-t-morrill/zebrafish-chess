+    def log_opening_name(self, board: chess.Board, game_id: str) -> None:
+        """Log the deepest recognized opening reached in the current game."""
+        if not opening_names or board.uci_variant != "chess":
+            return
+
+        replay = board.root()
+        opening = opening_names.get(" ".join(replay.fen().split()[:4]))
+        for move in board.move_stack:
+            replay.push(move)
+            found = opening_names.get(" ".join(replay.fen().split()[:4]))
+            if found is not None:
+                opening = found
+
+        if opening is not None and opening != self.last_logged_opening:
+            logger.info(f"Opening: {opening} (game {game_id})")
+            self.last_logged_opening = opening
 
