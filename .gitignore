# Legacy duplicates and disposable resources
/archive/

# Keep the final accepted source snapshot of each existing major version.
# Other snapshots remain on disk. Add an exception when retaining a new release.
# Major directories remain traversable so the source exceptions work.
/engines/versions/misc/
/engines/versions/v1/*
!/engines/versions/v1/source_1.7.1/
/engines/versions/v2/*
!/engines/versions/v2/source_2.3/
