+/* Direct and discovered checks after a non-castling move. The attacking
+ * piece sets lose the departure square and gain the final piece at its
+ * destination. En passant also uncovers a third square. */
+static bool noncastling_gives_check(const Position *p, Move move) {
+    Color us = p->side_to_move;
+    Color them = opposite(us);
+    int king = p->king_sq[them];
+    int from = MOVE_FROM(move), to = MOVE_TO(move);
+    uint64_t leave = ~square_bit(from), arrive = square_bit(to);
+    uint64_t occ = (p->occupied_all & leave) | arrive;
+    MoveFlag flag = MOVE_FLAG(move);
+    if (flag == MOVE_EN_PASSANT)
+        occ &= ~square_bit(to + (us == WHITE ? -8 : 8));
+    const uint64_t *pieces = p->pieces[us];
+    int type = flag_is_promotion(flag) ? piece_type(promoted_piece(us, flag)) :
+                                         piece_type(p->board[from]);
+    uint64_t pawns = (pieces[0] & leave) | (type == 1 ? arrive : 0);
+    uint64_t knights = (pieces[1] & leave) | (type == 2 ? arrive : 0);
+    uint64_t kings = (pieces[5] & leave) | (type == 6 ? arrive : 0);
+    if ((pawns & pawn_attacks_bb[them][king]) || (knights & knight_attacks_bb[king]) ||
+        (kings & king_attacks_bb[king])) return true;
+    uint64_t diagonal = ((pieces[2] | pieces[4]) & leave) |
+                        (type == 3 || type == 5 ? arrive : 0);
+    uint64_t straight = ((pieces[3] | pieces[4]) & leave) |
+                        (type == 4 || type == 5 ? arrive : 0);
+    return (diagonal & bishop_attacks_ray(king, occ)) ||
+           (straight & rook_attacks_ray(king, occ));
+}
